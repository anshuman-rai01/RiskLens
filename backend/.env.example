# ============================================================
# RiskLens Backend — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# NEVER commit the .env file — it may contain secrets.
# ============================================================

# ---------- Database ----------
# Async URL (used by the FastAPI app at runtime via asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/risklens

# Sync URL (used by Alembic for migrations via psycopg2)
# If omitted, it is auto-derived from DATABASE_URL by swapping the driver.
# DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/risklens

# ---------- Application ----------
APP_NAME=RiskLens
ENVIRONMENT=dev          # dev | prod

# ---------- CORS ----------
# Comma-separated list of allowed origins.
# Default covers the Vite dev server on port 3000.
CORS_ORIGINS=http://localhost:3000

# ---------- Auth (placeholder — not used until Chunk 2) ----------
# Generate a strong random key before Chunk 2:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_BEFORE_CHUNK_2
